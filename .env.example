# =============================================================================
# WooCommerce WhatsApp Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required fields are marked with [REQUIRED]
# Optional fields have sensible defaults or are marked [OPTIONAL]
# =============================================================================

# -----------------------------------------------------------------------------
# WhatsApp Cloud API Credentials [REQUIRED]
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_secret_token_for_webhook_validation

# App Secret for webhook signature verification (recommended for production)
# WHATSAPP_APP_SECRET=your_app_secret

# -----------------------------------------------------------------------------
# WooCommerce REST API Credentials [REQUIRED]
# -----------------------------------------------------------------------------
WOOCOMMERCE_URL=https://your-store-url.com
WOOCOMMERCE_KEY=ck_your_woocommerce_consumer_key
WOOCOMMERCE_SECRET=cs_your_woocommerce_consumer_secret

# WooCommerce Webhook Secret (for verifying incoming webhooks)
# WOOCOMMERCE_WEBHOOK_SECRET=your_webhook_secret

# -----------------------------------------------------------------------------
# Supabase Database [REQUIRED]
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-or-anon-key

# -----------------------------------------------------------------------------
# AI / LLM Configuration [REQUIRED for RAG features]
# -----------------------------------------------------------------------------
# Provider: "openai" or "anthropic"
# These are OPTIONAL here if you store them in the Supabase 'config' table.
# The app loads keys from Supabase at startup. Local .env values take priority.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# Embedding Model [OPTIONAL]
# -----------------------------------------------------------------------------
# Default: BAAI/bge-small-en-v1.5 (runs locally via FastEmbed)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# -----------------------------------------------------------------------------
# Wit.ai NLU [OPTIONAL]
# -----------------------------------------------------------------------------
# Enables AI intent classification for better message routing.
# WIT_AI_SERVER_TOKEN=your_wit_server_token

# -----------------------------------------------------------------------------
# Human Agent Phone [OPTIONAL]
# -----------------------------------------------------------------------------
# Phone number for support escalation (E.164 format)
# HUMAN_AGENT_PHONE=8801952700500

# -----------------------------------------------------------------------------
# Background Workers [OPTIONAL]
# -----------------------------------------------------------------------------
# Interval (seconds) for fuzzy search index re-sync from WooCommerce
# FUZZY_RESYNC_INTERVAL=21600
